# ==== Discord Bot ====
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
GUILD_ID=your_guild_id

# OAuth2のリダイレクトURI（Discord Developer Portal の OAuth2 設定に登録するURLと完全一致させること）
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# 付与するロールID
VERIFIED_ROLE_ID=role_id_for_verified
UNVERIFIED_ROLE_ID=role_id_for_unverified

# 参加を知らせるチャンネル（任意・DM失敗時の代替告知等に利用したい場合）
WELCOME_CHANNEL_ID=

# ==== Web Server ====
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_random_long_string

# ==== Turnstile ====
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ==== ルール ====
JOIN_TIMEOUT_HOURS=24
COOLDOWN_MINUTES=1
MAX_WRONG_STREAK=3
QUIZ_QUESTION_COUNT=3
